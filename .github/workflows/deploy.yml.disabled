name: Deploy Agent2Agent to Cloud Run
on:
 push:
   branches: [ main ]

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest # we can change as per our runner machine

    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: Authenticate to Google Cloud
      uses: google-github-actions/auth@v2
      with:
        workload_identity_provider: 'projects/YOUR_PROJECT_NUMBER/locations/global/workloadIdentityPools/github-pool/providers/github'
        service_account: 'github-deployer@YOUR_PROJECT_ID.iam.gserviceaccount.com'

    - name: Set up gcloud CLI
      uses: google-github-actions/setup-gcloud@v2

    - name: Submit Cloud Build
      run: gcloud builds submit --config cloudbuild.yaml .

    - name: Deploy to Cloud Run (Dev)
      if: github.ref == 'refs/heads/dev'
      run: gcloud run services replace cloudrun-dev.yaml --region <region name>

    - name: Deploy to Cloud Run (Prod)
      if: github.ref == 'refs/heads/main'
      run: gcloud run services replace cloudrun-prod.yaml --region <region name>
