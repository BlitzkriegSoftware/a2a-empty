FROM python:3.11-slim

SHELL ["/bin/bash", "-c"]

WORKDIR /app

# Install base tools and the uv binary (manual install = stable)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        tar \
        xz-utils \
    && \
    curl -L https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-musl.tar.gz \
        -o uv.tar.gz && \
    tar -xvzf uv.tar.gz && \
    mv uv-x86_64-unknown-linux-musl/uv /usr/local/bin/uv && \
    rm uv.tar.gz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*


# Copy project metadata for uv
COPY pyproject.toml uv.lock* /app/


# Copy your application source files

COPY . /app

# Ensure Python sees /app as the root for imports like good.a2a_server
ENV PYTHONPATH="/app"


# Install dependencies using uv (creates .venv)

RUN uv sync --all-groups && \
    uv sync --upgrade

EXPOSE 8080


# Run  server
CMD ["uv", "run", "python", "-m", "src.main", "server", "agent", "good", "--host", "0.0.0.0", "--port", "8080"]
